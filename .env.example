# ---------------------------------------------------------------------------
# Configuration Bonresto — copier vers .env et renseigner.
#
# Audit F-01 : ces variables n'avaient AUCUN mecanisme de chargement. Chaque
# getenv() retombait sur une valeur de repli ecrite dans le depot, donc connue
# de quiconque a acces au code. Les valeurs de repli ont ete supprimees :
# l'application refuse desormais de demarrer si un secret manque.
#
# Ce fichier est lu par index.php. Une variable deja posee dans
# l'environnement du serveur (SetEnv Apache, panneau d'hebergeur) a la
# priorite sur ce qui est ecrit ici.
# ---------------------------------------------------------------------------

# Environnement : development | testing | production
CI_ENV=production

# ── Base de donnees ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
SAAS_DB_NAME=

# ── Secrets — generer avec : php -r "echo bin2hex(random_bytes(32));" ──────
# Cle de chiffrement CodeIgniter (cookies, sessions chiffrees). 32 caracteres.
# Sa rotation deconnecte les sessions en cours.
CI_ENCRYPTION_KEY=

# Signature des jetons de la console SaaS. Sa rotation invalide les jetons emis.
SAAS_JWT_SECRET=

# Signature des payloads de licence.
# IMPORTANT : la MEME valeur doit etre posee cote serveur SaaS (qui signe,
# saas/controllers/Licenses.php) et cote installation cliente (qui verifie,
# libraries/License_manager.php). Deux valeurs differentes = licences rejetees.
LICENSE_HMAC_SECRET=

# Cle des taches planifiees (/saas/cron/run, migrate_*, stock_alert_cron).
SAAS_CRON_KEY=

# ── URL du serveur SaaS — HTTPS obligatoire en production ──────────────────
SAAS_URL=https://votre-domaine/index.php/saas

# ── Passerelle Stripe (facultatif) ─────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
