# ---------------------------------------------------------------------------
# Configuration Bonresto — copier vers .env et renseigner.
#
# Audit F-01 : ces variables n'avaient AUCUN mecanisme de chargement. Chaque
# getenv() retombait sur une valeur de repli ecrite dans le depot, donc connue
# de quiconque a acces au code. Les valeurs de repli ont ete supprimees :
# l'application refuse desormais de demarrer si un secret manque.
#
# Ce fichier est lu par index.php. Une variable deja posee dans
# l'environnement du serveur (SetEnv Apache, panneau d'hebergeur) a la
# priorite sur ce qui est ecrit ici.
# ---------------------------------------------------------------------------

# Environnement : development | testing | production
CI_ENV=production

# ── Base de donnees ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
SAAS_DB_NAME=

# ── Secrets — generer avec : php -r "echo bin2hex(random_bytes(32));" ──────
# Cle de chiffrement CodeIgniter (cookies, sessions chiffrees). 32 caracteres.
# Sa rotation deconnecte les sessions en cours.
CI_ENCRYPTION_KEY=

# Signature des jetons de la console SaaS. Sa rotation invalide les jetons emis.
SAAS_JWT_SECRET=

# Signature des payloads de licence.
# IMPORTANT : la MEME valeur doit etre posee cote serveur SaaS (qui signe,
# saas/controllers/Licenses.php) et cote installation cliente (qui verifie,
# libraries/License_manager.php). Deux valeurs differentes = licences rejetees.
LICENSE_HMAC_SECRET=

# Cle des taches planifiees (/saas/cron/run, migrate_*, stock_alert_cron).
SAAS_CRON_KEY=

# ── URL du serveur SaaS — HTTPS obligatoire en production ──────────────────
SAAS_URL=https://votre-domaine/index.php/saas

# ── Passerelle Stripe (facultatif) ─────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=

# Origines autorisees pour la console SaaS (F-21), separees par des virgules
SAAS_CORS_ORIGINS=

# Secret partage des rappels de paiement (F-08). Un par operateur si besoin :
# WEBHOOK_AIRTEL_SECRET / WEBHOOK_MTN_SECRET, sinon WEBHOOK_SECRET pour les deux.
WEBHOOK_SECRET=

# ── Signature des licences — Audit F-05 ────────────────────────────────────
# Generer la paire :
#   php -r '$k=sodium_crypto_sign_keypair();
#           echo base64_encode(sodium_crypto_sign_secretkey($k)),"\n",
#                base64_encode(sodium_crypto_sign_publickey($k)),"\n";'
#
# LICENSE_SIGNING_KEY (privee) : UNIQUEMENT sur le serveur SaaS, qui signe.
# LICENSE_PUBLIC_KEY  (publique) : sur chaque installation cliente, qui verifie.
# Une installation cliente ne doit JAMAIS recevoir la cle privee — c'etait tout
# le defaut du HMAC partage qu'elle remplace.
LICENSE_SIGNING_KEY=
LICENSE_PUBLIC_KEY=

# ── Notifications OneSignal ────────────────────────────────────────────────
# Cle REST API. Elle etait ecrite en clair dans
# api/application/config/notification.php, fichier suivi par git sur un depot
# public : elle a donc fuite et doit etre revoquee cote OneSignal.
# Les App ID restent dans la config — ce sont des identifiants publics,
# embarques dans les applications clientes.
ONESIGNAL_API_KEY=
