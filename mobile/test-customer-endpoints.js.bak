const axios = require('axios');
const FormData = require('form-data');

const API_BASE_URL = 'http://127.0.0.1/bonresto/index.php';
let authToken = null;

const client = axios.create({
  baseURL: API_BASE_URL,
  headers: {
    'Content-Type': 'multipart/form-data',
    'Accept': 'application/json'
  }
});

// Test credentials
        const authData = {
            customer_email: 'customer@example.com',    // Replace with valid credentials
            password: '123456',                      // Replace with valid credentials
            token: 'test-fcm-token-' + Date.now()    // FCM token
        };
        const authResponse = await makeAuthRequest('Android/sign_in', authData);

async function authenticate() {
  console.log('Authenticating...');
  try {
    const form = new FormData();
    form.append('email', TEST_CREDENTIALS.customer.email);
    form.append('password', TEST_CREDENTIALS.customer.password);
    form.append('token', TEST_CREDENTIALS.customer.token);
    
    const response = await client.post('/V3/sign_in', form);
    console.log('Auth Response:', JSON.stringify(response.data, null, 2));
    
    if (response.data.token) {
      authToken = response.data.token;
      console.log('Authentication successful');
    } else {
      console.error('No token received in auth response');
    }
  } catch (err) {
    console.error('Authentication failed:', err.response?.data || err.message);
  }
}

async function testEndpoint(name, fn) {
  try {
    console.log(`\nTesting ${name}...`);
    const result = await fn();
    console.log('Success:', JSON.stringify(result.data, null, 2));
    return result.data;
  } catch (err) {
    console.error('Error:', err.response?.data || err.message);
    return null;
  }
}

async function runCustomerTests() {
  console.log('Starting Customer API endpoint tests...\n');

  // First authenticate
  await authenticate();

  // 1. Test Category List
  await testEndpoint('Get Category List', async () => {
    const form = new FormData();
    form.append('id', '0'); // Parent category ID (0 for all)
    if (authToken) form.append('token', authToken);
    return client.post('/Api_v2/categorylist', form);
  });

  // 2. Test All Food List
  await testEndpoint('Get All Food List', async () => {
    const form = new FormData();
    form.append('id', '1');       // Customer ID
    form.append('CategoryID', '1'); // Category ID (optional)
    form.append('page', '1');      // Page number
    form.append('limit', '10');    // Items per page
    if (authToken) form.append('token', authToken);
    return client.post('/Api_v2/foodlist', form);
  });

  // 3. Test Food Details
  await testEndpoint('Get Food Details', async () => {
    const form = new FormData();
    form.append('id', '1');        // Customer ID
    form.append('ProductsID', '1'); // Product ID
    if (authToken) form.append('token', authToken);
    return client.post('/Api_v2/fooddetails', form);
  });

  // 4. Test Add to Cart
  await testEndpoint('Add to Cart', async () => {
    const form = new FormData();
    form.append('id', '1');          // Customer ID
    form.append('ProductsID', '1');   // Product ID
    form.append('variantid', '1');    // Variant ID
    form.append('quantity', '1');     // Quantity
    form.append('size', '');         // Size (optional)
    if (authToken) form.append('token', authToken);
    return client.post('/Api_v2/addtocart', form);
  });

  // 5. Test Cart List
  await testEndpoint('Get Cart List', async () => {
    const form = new FormData();
    form.append('id', '1');         // Customer ID
    if (authToken) form.append('token', authToken);
    return client.post('/Api_v2/cartdata', form);
  });

  // 6. Test Place Order
  await testEndpoint('Place Order', async () => {
    const form = new FormData();
    form.append('id', '1');              // Customer ID
    form.append('grandtotal', '100');    // Total amount
    form.append('payment_method', '1');   // Payment method ID
    form.append('table_no', '1');        // Table number
    form.append('customer_note', 'Test order'); // Order notes
    form.append('customerpaid', '100');  // Amount paid
    form.append('customer_type', '1');   // Customer type
    if (authToken) form.append('token', authToken);
    return client.post('/Api_v2/placeorder', form);
  });

  // 7. Test Order History
  await testEndpoint('Get Order History', async () => {
    const form = new FormData();
    form.append('id', '1');          // Customer ID
    form.append('limit', '10');      // Items per page
    form.append('page', '1');        // Page number
    if (authToken) form.append('token', authToken);
    return client.post('/Api_v2/orderlist', form);
  });

  // 8. Test Order Details
  await testEndpoint('Get Order Details', async () => {
    const form = new FormData();
    form.append('id', '1');      // Customer ID
    form.append('order_id', '1'); // Order ID
    if (authToken) form.append('token', authToken);
    return client.post('/Api_v2/orderdetails', form);
  });
}

// Install dependencies and run tests
console.log('Installing dependencies...');
require('child_process').execSync('npm install axios form-data', { stdio: 'inherit' });

console.log('\nRunning customer app tests...');
runCustomerTests().catch(console.error);