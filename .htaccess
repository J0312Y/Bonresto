# ---------------------------------------------------------------------------
# Fichiers qui ne doivent jamais etre servis, quelle que soit leur position.
# Audit F-03 : quatre sauvegardes SQL completes etaient telechargeables depuis
# la racine, dont saas_dump.sql (comptes super-admin, empreintes, SMTP).
# ---------------------------------------------------------------------------
<FilesMatch "\.(sql|bak|bak1|log|zip|rar|gz|tar|env|json~|ini|sh|dist)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Fichiers caches (.env, .git, .htpasswd...)
<FilesMatch "^\.">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Pas de listage de repertoire
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Pas de RewriteBase : mod_rewrite deduit alors la base du repertoire
    # ou vit ce .htaccess. C'est juste a la racine d'un domaine comme dans
    # un sous-repertoire, donc portable entre le serveur et un MAMP local.
    #
    # La valeur codee en dur /bonresto ne valait que pour le second cas :
    # a la racine d'un domaine elle produisait /bonresto/index.php/..., un
    # chemin inexistant, donc une boucle de redirections internes et un 500
    # sur TOUTE URL propre. L'app n'etait joignable qu'en /index.php/...

    # Pass Authorization header to PHP (required for JWT with CGI/FastCGI)
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # SaaS Admin SPA — serve index.html for any non-file path under dist/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^saas-bonresto/admin/dist/(.*)$ saas-bonresto/admin/dist/index.html [L]

    # Audit F-23 : l'installateur reste deploye et joignable. Il cree des
    # comptes et ecrit la configuration : il ne doit etre accessible que
    # pendant une installation. Commenter la ligne suivante pour reinstaller,
    # puis la retablir.
    RewriteRule ^install/ - [F,L]

    # CodeIgniter routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
