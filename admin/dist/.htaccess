Alias /admin/dist /var/www/bonresto/admin/dist

<Directory /var/www/bonresto/admin/dist>
    Options -MultiViews
    AllowOverride All
    Require all granted

    RewriteEngine On
    RewriteBase /admin/dist/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /admin/dist/index.html [L]
</Directory>
